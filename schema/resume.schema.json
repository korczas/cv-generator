{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CV generator resume",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "template": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "theme": {
      "$ref": "#/definitions/theme"
    },
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "photo": {
          "type": "string"
        },
        "showPhoto": {
          "type": "boolean"
        },
        "links": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "url": {
                "type": "string",
                "pattern": "^https?://[^\\s<>\"\\x00-\\x20]+$"
              }
            },
            "required": ["label", "url"]
          }
        }
      },
      "required": ["name"]
    },
    "summary": {
      "type": "string"
    },
    "consent": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sub": {
            "type": "string"
          }
        },
        "required": ["value", "label"]
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "items": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": ["category", "items"]
      }
    },
    "experience": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "period": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "location": {
            "type": "string"
          },
          "highlights": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": ["company", "role"]
      }
    },
    "achievements": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "icon": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["title", "description"]
      }
    },
    "speaking": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "venue": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "year": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "required": ["title"]
      }
    },
    "projects": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://[^\\s<>\"\\x00-\\x20]+$"
          },
          "highlights": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": ["name"]
      }
    },
    "education": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "institution": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "degree": {
            "type": "string"
          },
          "period": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "required": ["institution"]
      }
    },
    "languages": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "level": {
            "type": "string"
          }
        },
        "required": ["name"]
      }
    }
  },
  "required": ["basics"],
  "definitions": {
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[-#(),.%a-zA-Z0-9\\s]+$"
          }
        },
        "fonts": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^<>;{}\\\\\\x00-\\x1f]*$"
          },
          "properties": {
            "googleFontsHref": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^[^<>\"\\\\\\s]*$"
            }
          }
        },
        "layout": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 5000
          }
        },
        "icons": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
